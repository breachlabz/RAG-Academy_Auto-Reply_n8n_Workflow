# Copy to .env and set the three values below. Nothing else is required.
#
#   cp .env.example .env
#   docker compose up -d --build
#   docker compose exec classifier python -m rag ingest --reset

# --- 1. Your chat model's OpenAI-compatible endpoint, as seen from docker -----
# LiteLLM on this same host:   http://host.docker.internal:4000/v1
# LiteLLM on another box:      http://<its-ip>:4000/v1
# Ollama on this same host:    http://host.docker.internal:11434/v1
# Ollama on another box:       http://<its-ip>:11434/v1
LLM_URL=http://host.docker.internal:4000/v1

# --- 2. API key (blank for Ollama, or for a LiteLLM proxy with no auth) -------
LLM_KEY=

# --- 3. The model name the endpoint exposes for chat ------------------------
# Used for BOTH classification and reply drafting. Point it at the 27B you
# already run -- this project needs no model of its own.
#   LiteLLM: the model_list name        e.g. qwen3-27b
#   Ollama:  the pulled tag             e.g. qwen3:32b   (run `ollama list`)
CHAT_MODEL=qwen3-27b

# ===========================================================================
# OLLAMA BACKEND -- uncomment this block if CHAT_MODEL is served by Ollama.
# ===========================================================================
# Ollama's OpenAI endpoint returned no token logprobs before ~v0.12. Without
# them the classifier cannot compute confidence and sends EVERY email to the
# human queue. Setting this routes on the model's bare true/false answer
# instead: still fails safe, but the confidence threshold no longer applies.
# First run the logprobs check in HANDOFF.md section 6 -- only set this if it
# comes back empty.
# EC_ALLOW_UNCALIBRATED=1
#
# Ollama defaults to a 4096-token context and silently truncates longer
# prompts, cutting off document extracts. Prefer OLLAMA_CONTEXT_LENGTH=8192 on
# the Ollama service itself; this is the fallback if you cannot set that.
# EC_NUM_CTX=8192

# --- other optional settings ------------------------------------------------
# A larger model for `python -m rag ask --large` evals only. Defaults to CHAT_MODEL.
# CHAT_MODEL_LARGE=
# Classifier confidence bar for routing to the RAG auto-reply (default 0.9).
# EC_THRESHOLD=0.9
