# Optional per-host overrides. Copy to docker-compose.override.yml (gitignored)
# and Docker Compose merges it on top of docker-compose.yml automatically.
#
#   cp docker-compose.override.yml.example docker-compose.override.yml
#
# Use this when your chat model (LiteLLM / Ollama) and this stack run on the
# same Docker host but the model server is NOT reachable via
# host.docker.internal -- e.g. it publishes only on 127.0.0.1, or it lives in
# another compose project. Join its network and address it by service name.
#
# Then in .env:   LLM_URL=http://litellm:4000/v1   (service name + container port)

services:
  classifier:
    # Only if the model server's network also has a container called "chromadb":
    # pin this stack's Chroma by its unique container_name to avoid the clash.
    # environment:
    #   - RAG_CHROMA_HOST=email-classifier-chroma
    networks:
      - emailflow
      - modelnet
  n8n:
    networks:
      - emailflow
      - modelnet

networks:
  modelnet:
    external: true
    # `docker network ls` -- the network the model server is attached to.
    name: ai-server_ai-network
