# OPTIONAL per-host wiring. A normal production server does NOT need this file:
# docker-compose.yml on its own is self-contained (its own Chroma, embedder,
# API and n8n), and reaches the chat model through LLM_URL in .env.
#
# Use it only when the chat model (or another service) runs in a *different*
# docker compose stack on the same host and is reachable only on that stack's
# docker network. Then:
#
#   cp docker-compose.override.yml.example docker-compose.override.yml
#   # set `name:` below to that network (list them with: docker network ls)
#   docker compose up -d
#
# and set LLM_URL in .env to http://<that-service-name>:<container-port>/v1.
# `docker compose` picks the override file up automatically. It is gitignored,
# so it is never committed -- keep a copy with the host's other config.

services:
  classifier:
    networks:
      - emailflow
      - modelnet
    # Only if you deliberately want this stack to use ANOTHER stack's Chroma
    # instead of its own local_chromadb (the dev box does this). If you set it,
    # n8n's academy_docs Chroma credential must point at that same instance.
    # environment:
    #   - RAG_CHROMA_HOST=chromadb

  n8n:
    networks:
      - emailflow
      - modelnet

networks:
  modelnet:
    external: true
    name: ai-server_ai-network   # <- change to your model stack's network
