{
  "name": "Academy Auto-Reply (Outlook)",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "output": "fields",
        "fields": [
          "id",
          "conversationId",
          "subject",
          "bodyPreview",
          "body",
          "internetMessageId",
          "from",
          "receivedDateTime"
        ],
        "filters": {
          "foldersToInclude": [
            "inbox"
          ]
        },
        "options": {}
      },
      "id": "outlook-trigger",
      "name": "New Outlook email",
      "type": "n8n-nodes-base.microsoftOutlookTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "credentials": {
        "microsoftOutlookOAuth2Api": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Microsoft Outlook account"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://classifier:8100/generate-reply",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ email_text: ($json.body && $json.body.content ? $json.body.content : $json.bodyPreview) || '', is_html: ($json.body && $json.body.contentType ? $json.body.contentType === 'html' : true), conversation_id: $json.conversationId || '', subject: $json.subject || '', message_id: $json.internetMessageId || $json.id || '' }) }}",
        "options": {
          "timeout": 180000
        }
      },
      "id": "generate-reply",
      "name": "Classify + RAG reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "onError": "continueRegularOutput",
      "notes": "Classifier gate runs INSIDE this call. Non-academic email comes back answered=false, so no draft is created."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "answered-true",
              "leftValue": "={{ $json.answered }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-answered",
      "name": "Grounded answer?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.microsoft.com/v1.0/me/messages/{{ $('New Outlook email').item.json.id }}/createReply",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "microsoftOutlookOAuth2Api",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ comment: $json.reply }) }}",
        "options": {}
      },
      "id": "create-draft",
      "name": "Create Outlook draft reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        -100
      ],
      "credentials": {
        "microsoftOutlookOAuth2Api": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Microsoft Outlook account"
        }
      },
      "notes": "createReply makes a DRAFT reply inside the original conversation. It never sends. Sending requires a separate POST to /send, which this workflow deliberately does not contain."
    },
    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "={{ JSON.stringify({ skipped: true, subject: $('New Outlook email').item.json.subject, conversation_id: $json.conversation_id, type: $json.type, route: $json.route, reason: $json.reason, duplicate: $json.duplicate }) }}",
        "options": {}
      },
      "id": "no-draft",
      "name": "No draft (human queue)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        720,
        100
      ],
      "notes": "Terminal by design. Non-academic, ungrounded and duplicate email all land here and stay in the inbox for a human. Replace with a Teams/Slack/ticket node if you want an active notification."
    }
  ],
  "connections": {
    "New Outlook email": {
      "main": [
        [
          {
            "node": "Classify + RAG reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Classify + RAG reply": {
      "main": [
        [
          {
            "node": "Grounded answer?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Grounded answer?": {
      "main": [
        [
          {
            "node": "Create Outlook draft reply",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "No draft (human queue)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}
